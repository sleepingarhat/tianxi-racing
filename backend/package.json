{
  "name": "tianxi-backend",
  "version": "1.0.0",
  "description": "\u5929\u559c\u5a1b\u6a02 Tianxi Entertainment - \u8cfd\u99acAI\u5206\u6790\u5e73\u53f0\u5f8c\u7aef",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute tianxi-db --local --file=./src/db/schema.sql && wrangler d1 execute tianxi-db --local --file=./src/db/schema_v2.sql",
    "db:migrate:remote": "wrangler d1 execute tianxi-db --remote --file=./src/db/schema.sql && wrangler d1 execute tianxi-db --remote --file=./src/db/schema_v2.sql",
    "db:seed": "tsx scripts/import-csv.ts",
    "typecheck": "tsc --noEmit",
    "test:horse-career-stats": "tsx scripts/test-horse-career-stats.ts",
    "test:horse-career-api": "tsx scripts/test-horse-career-api.ts",
    "scrape-racecard": "tsx scripts/scrape-racecard.ts",
    "test:market-blend": "tsx scripts/test-market-blend.ts",
    "test:running-style": "tsx scripts/test-running-style.ts",
    "test:public-today-picks": "tsx scripts/test-public-today-picks.ts",
    "test:membership": "tsx scripts/test-membership.ts",
    "test:admin-auth": "tsx scripts/test-admin-auth.ts",
    "test:prediction-lock": "tsx scripts/test-prediction-lock.ts",
    "test:freeze-ledger-perf": "bun scripts/test-freeze-ledger-perf.ts",
    "test:data-stats": "bun scripts/test-data-stats.ts",
    "test:push-delta-sync": "tsx scripts/test-push-delta-sync.ts",
    "test:lock-window": "bun scripts/test-lock-window.ts",
    "test:watch-events": "tsx scripts/test-watch-events.ts",
    "test:cors-policy": "tsx scripts/test-cors-policy.ts",
    "test:security-guards": "bun scripts/test-security-guards.ts",
    "test:lab-h2h": "tsx scripts/test-lab-h2h.ts",
    "test:lab-h2h-auth": "tsx scripts/test-lab-h2h-auth.ts",
    "test:notify-events": "tsx scripts/test-notify-events.ts",
    "test:lab-pace": "tsx scripts/test-lab-pace.ts",
    "test:lab-pace-auth": "tsx scripts/test-lab-pace-auth.ts",
    "test:lab-going": "tsx scripts/test-lab-going.ts",
    "test:lab-going-auth": "tsx scripts/test-lab-going-auth.ts",
    "test:lab-pools": "tsx scripts/test-lab-pools.ts",
    "test:lab-pools-auth": "tsx scripts/test-lab-pools-auth.ts",
    "test:api-v1-auth": "tsx scripts/test-api-v1-auth.ts",
    "test:api-v1-keys": "tsx scripts/test-api-v1-keys.ts"
  },
  "dependencies": {
    "hkjc-api": "^1.0.5",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260416.2",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^11.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.83.0"
  }
}
